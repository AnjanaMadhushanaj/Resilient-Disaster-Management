# Copy to .env for local `docker compose up`. .env is gitignored.
#
# Both values are compiled into the dashboard image at build time.

# Public address the browser uses to reach the API. Omit for localhost.
# On the EC2 instance the pipeline writes this automatically.
# PUBLIC_HOST=13.234.10.55

# Mapbox public access token (pk.*), required for the satellite map.
# Without it the dashboard renders a "Map unavailable" panel.
# https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=
