# Copy to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored.

aws_region   = "ap-south-1"
project_name = "flood-detection-demo"

# Must already exist in the target region:
#   aws ec2 describe-key-pairs --region ap-south-1
key_name = "your-key-pair-name"

# Recommended: lock SSH to your own address instead of leaving it world-open.
# allowed_ssh_cidr = "203.0.113.4/32"
